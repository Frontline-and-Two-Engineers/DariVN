# DariVN Glossary & Terminology Database
# Формат словаря:
# [term_id]
# title = Заголовок
# description = Подробное описание термина
# или компактно:
# term_id = Заголовок | Описание

[shader]
title = Шейдер (GPU Shader)
description = Специализированная программа, выполняемая на графическом процессоре (GPU) для создания визуальных спецэффектов: волн, свечения, размытия, хроматической аберрации и цветокоррекции сцены в реальном времени.

[nvl]
title = Режим NVL (Novel Style)
description = Традиционный формат отображения визуальных новелл, когда текст реплик накапливается страницей поверх полупрозрачной затемненной панели на весь экран (как в Fate/stay night или Бесконечном Лете).

[astral]
title = Астральное измерение
description = Тонкоматериальное поле чистой энергии и мыслеобразов, связывающее воспоминания и параллельные временные линии путешественника.
